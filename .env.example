NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Push notifications (optional). Generate the pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact sent to push services: a mailto: or https: URL
VAPID_SUBJECT=mailto:you@example.com

# Secret for the cron routes (/api/cron/*), sent as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Strava (optional): API app from strava.com/settings/api; verify token = any random string
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
