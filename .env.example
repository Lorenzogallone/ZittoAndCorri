NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Show the "Sign in with Google" button (default: true). Set to false if you did not
# configure Google OAuth in Supabase; email magic-link sign-in always works.
NEXT_PUBLIC_AUTH_GOOGLE=true

# Push notifications (optional). Generate the pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact sent to push services: a mailto: or https: URL
VAPID_SUBJECT=mailto:you@example.com

# Secret for the cron routes (/api/cron/*), sent as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
